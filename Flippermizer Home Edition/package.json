{
  "name": "flippermizer-home-edition",
  "version": "1.2.0",
  "description": "Home Edition AP/SP client for Flippermizer! Pinball Randomized!",
  "main": "electron/main.js",
  "private": true,
  "author": "Ashodin",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/standalone-overlay-bridge.js && node --check electron/standalone-gift-house-test.js && node --check flippermizer_table_repository.js && node --check flippermizer_deep_run_catalog.js && node --check flippermizer_task_explanations.js",
    "dist:dir": "node tools/ensure_home_icon_ico.js && electron-builder --dir && node tools/stamp_unpacked_icon.js",
    "dist:portable": "npm run dist:dir && electron-builder --win portable --prepackaged dist/win-unpacked",
    "dist": "npm run dist:portable"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.flippermizer.homeedition",
    "productName": "Flippermizer! Pinball Randomized! | Home Edition",
    "executableName": "Flippermizer Home Edition",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/standalone-overlay-bridge.js",
      "electron/standalone-gift-house-test.js",
      "flippermizer_overlay_tower_v3.html",
      "flippermizer_table_repository.js",
      "flippermizer_deep_run_catalog.js",
      "flippermizer_task_explanations.js",
      "flippermizer_task_repository.html",
      "flippermizer_task_repository_data.js",
      "flippermizer_task_repository_cfg.js",
      "vendor/**/*",
      "build/home-icon.ico",
      "build/icon.ico",
      "build/icon.png",
      "sounds/**/*",
      "WorldsBanners/**/*",
      "Flippermizer Images/**/*",
      "LICENSE",
      "README.md"
    ],
    "asar": false,
    "win": {
      "signAndEditExecutable": false,
      "icon": "home-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "home-icon.ico",
      "uninstallerIcon": "home-icon.ico",
      "installerHeaderIcon": "home-icon.ico"
    },
    "portable": {
      "artifactName": "Flippermizer-Home-Edition-${version}-portable.exe"
    }
  }
}
