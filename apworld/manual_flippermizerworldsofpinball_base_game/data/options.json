{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal": {
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": "How to End your Randomized playthrough.",
            "aliases": {
                "easiest": 0
            },
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 16
            },
            "default": 0
        }
    },
    "user": {
        "_commented_out_option": {
            "type": "Toggle",
            "default": true
        },
        "Example_Toggle": {
            "description": [
                "This is a Toggle",
                "A simple boolean, aka True or False set the initial value with \"default\""
            ],
            "type": "Toggle",
            "default": false,
            "hidden": true,
            "group": "Example Options"
        },
        "Example_Choice": {
            "type": "Choice",
            "description": [
                "This is a Choice",
                "Let the user pick from a list of values",
                "allow_custom_value let a player define their own text value",
                "Currently the only use for Choice in Manual outside of hooks is the goal"
            ],
            "values": {
                "start": 0,
                "test": 1
            },
            "default": 0,
            "allow_custom_value": false,
            "hidden": true,
            "group": "Example Options"
        },
        "Example_Range": {
            "type": "Range",
            "description": [
                "This is a Range",
                "Allow the player to specify a value between 'start' and 'end'",
                "if you include a \"values\" you can define the label for certain values",
                "Currently the only use for Range in Manual outside of hooks is 'filler_trap'"
            ],
            "range_start": 0,
            "default": 1,
            "range_end": 10,
            "values": {
                "example": 2
            },
            "hidden": true,
            "group": "Example Options"
        },
        "filter_mode_trap_enabled": {
            "display_name": "Filter Trap Enabled",
            "description": "Include Filter Mode Trap in the trap item pool.",
            "type": "Toggle",
            "default": false,
            "group": "Trap Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "boss_keys_required_for_boss_table_open": {
            "display_name": "Boss Keys Required",
            "description": "How many Boss Keys are required to open the Boss Table.",
            "type": "Range",
            "range_start": 1,
            "range_end": 10,
            "default": 3,
            "group": "Boss Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "task_shuffle_enabled": {
            "display_name": "Task Shuffle Enabled",
            "description": "Shuffle Task objectives between Task checks of the same difficulty. Score and Boss checks stay fixed.",
            "type": "Toggle",
            "default": false,
            "group": "Task Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "score_adjustment_mode": {
            "display_name": "Score Adjustment Mode",
            "description": "Overlay-only score display multiplier for score checks. Easy shows half scores, Normal shows baseline scores, Hard shows 1.5x scores, and Maddening shows 2x scores.",
            "type": "Choice",
            "values": {
                "easy": 0,
                "normal": 1,
                "hard": 2,
                "maddening": 3
            },
            "default": 1,
            "group": "Task Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "random_start_tables_open": {
            "display_name": "Random Start Tables Open",
            "description": "Use the player file's generated five-table random Ball 1 start instead of a fixed opening spread.",
            "type": "Toggle",
            "default": false,
            "group": "Start Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_active_table_count": {
            "display_name": "Base Game Active Table Count",
            "description": "How many tables from the larger Base Game pool should exist in this seed's active graph. For the current episode contract, this stays at 25 so the seed is built from five 5-table worlds.",
            "type": "Range",
            "range_start": 5,
            "range_end": 25,
            "default": 25,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_selection_mode": {
            "display_name": "Base Game Selection Mode",
            "description": "How the active Base Game world groups should be assembled from the catalog. Random chooses five-world packs at random. Curated reads the curated world-group list. Hybrid uses the curated list first and random-fills the rest.",
            "type": "Choice",
            "values": {
                "random_catalog_pool": 0,
                "curated_catalog_groups": 1,
                "hybrid_curated_random_fill": 2
            },
            "default": 0,
            "allow_custom_value": false,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_curated_world_groups": {
            "display_name": "Base Game Curated World Groups",
            "description": [
                "Comma-separated world group keys, labels, table codes, or table names in the episode order you want them to appear.",
                "Used when Base Game Selection Mode is Curated or Hybrid.",
                "Examples: storm_chasers, steve_ritchie_showcase, dennis_nordman_party_monsters."
            ],
            "type": "Choice",
            "values": {
                "auto": 1
            },
            "default": 1,
            "allow_custom_value": true,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_random_one_featured_designer_only": {
            "display_name": "Random Limit Featured Designer Worlds",
            "description": "When enabled, random Base Game world selection will include at most one Featured Designer world. Fully curated selections are left alone, but hybrid random fill also respects the cap.",
            "type": "Toggle",
            "default": false,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_starting_open_table_count": {
            "display_name": "Base Game Starting Open Count",
            "description": "How many of the active Base Game tables should be flagged as the initial open set in the seed-time payload.",
            "type": "Range",
            "range_start": 1,
            "range_end": 10,
            "default": 5,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "base_game_enabled": {
            "display_name": "Base Game Layout Payload",
            "description": "Emit Base Game active-table-set payloads in slot_data for clients and overlays.",
            "type": "Toggle",
            "default": true,
            "group": "Base Game Options",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ]
        },
        "DLC_enabled": {
            "display_name": "DLC Enabled",
            "description": "Is the Dlc enabled?",
            "type": "Toggle",
            "hidden": true,
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ],
            "default": true
        }
    }
}
